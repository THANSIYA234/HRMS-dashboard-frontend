# Base URL of the backend API (no trailing slash). Used to build absolute URLs
# for assets (e.g. profile images served from /uploads).
VITE_API_URL=https://hrms-dashboard-backend.onrender.com

# Axios base path. If your backend mounts routes under /api, include it here.
# The trailing /api is stripped when building asset URLs.
VITE_API_BASE=https://hrms-dashboard-backend.onrender.com/api